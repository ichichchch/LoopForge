{
  "version": "1.0",
  "id": "qoder",
  "compatibility": {
    "verified_on": "2026-11-18",
    "note": "Qoder Desktop；宿主提供 Agent 工具与自定义 Agent 类型"
  },
  "dispatch_tool": "Agent",
  "topology": "spawn",
  "stage_executor": "devflow-stage-executor",
  "research_executor": "devflow-research-helper",
  "required_tools": ["Agent"],
  "installation": {
    "project_dir": ".qoder",
    "agents_dir": "agents",
    "skills_dir": "skills",
    "skill_set": "portable"
  },
  "host_agents": [
    {
      "id": "devflow-stage-executor",
      "file": "devflow-stage-executor.md",
      "body": "../shared/agents/stage-executor.md",
      "description": "仅在 DevFlow 明确派发 DESIGN 及后续阶段时使用；每次执行一个逻辑角色",
      "frontmatter": {"permissionMode": "acceptEdits", "skills": [], "mcpServers": []},
      "access": "write"
    },
    {
      "id": "devflow-research-helper",
      "file": "devflow-research-helper.md",
      "body": "../shared/agents/research-helper.md",
      "description": "仅在 DevFlow 明确派发有边界的代码或知识检索时使用，不执行代码审查",
      "frontmatter": {"permissionMode": "plan", "skills": [], "mcpServers": []},
      "access": "read"
    }
  ]
}
